# Copy to .env.picnic.local, or point -PpicnicEnvFile at an existing auth.env.
# Never commit a real x-picnic-auth token.
PICNIC_AUTH="replace-with-your-session-token"
PICNIC_AGENT="30100;1.239.3-#15578"
PICNIC_DID="replace-with-your-stable-device-id"
PICNIC_UA="grocery-automate-picnic-live-smoke/1"
PICNIC_HOST="storefront-prod.nl.picnicinternational.com"

# Optional overrides. The agent value supplies client id, version, and build by default.
# Without PICNIC_AGENT, all three explicit values below are required. PICNIC_DEVICE_ID is
# accepted as a more descriptive alias for PICNIC_DID.
PICNIC_COUNTRY="nl"
PICNIC_API_VERSION="15"
# PICNIC_CLIENT_ID="30100"
# PICNIC_CLIENT_VERSION="1.239.3"
# PICNIC_BUILD_NUMBER="15578"
# PICNIC_DEVICE_ID="replace-with-your-stable-device-id"
